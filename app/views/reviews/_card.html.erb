<% review_title = item.name.presence || t("reviews.untitled") %>
<%= link_to review_path(item),
      class: "group block h-full rounded-2xl border border-zinc-200/80 bg-white shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 hover:shadow-md hover:shadow-zinc-950/10 dark:border-zinc-800/80 dark:bg-zinc-900 dark:shadow-none dark:hover:border-zinc-700" do %>
  <article class="flex h-full flex-col overflow-hidden rounded-2xl">
    <%= render "shared/cover",
          record: item,
          title: review_title,
          media_class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]" %>
    <div class="flex flex-1 flex-col gap-3 p-5">
      <% if item.cover_for_display? %>
        <h3 class="text-lg font-semibold leading-snug text-zinc-900 group-hover:text-zinc-700 dark:text-zinc-100 dark:group-hover:text-zinc-300">
          <%= review_title %>
        </h3>
      <% end %>
      <% if item.notion_created_at.present? %>
        <p class="mt-auto text-xs text-zinc-400 dark:text-zinc-500">
          <%= l(item.notion_created_at.to_date, format: :long) %>
        </p>
      <% end %>
    </div>
  </article>
<% end %>

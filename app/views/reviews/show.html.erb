<% content_for :title, @review.name.presence || "Review" %>
<% review_title = @review.name.presence || "Untitled review" %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: review_title,
        breadcrumbs: [
          { label: "Reviews", path: reviews_path },
          { label: review_title, current: true }
        ] %>

  <div class="flex flex-col gap-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <% if @review.archived? %>
          <span class="inline-flex rounded-md bg-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-700">Archived</span>
        <% end %>
      </div>
      <%= render "shared/notion_actions", record: @review %>
    </div>

    <%= render "shared/notion_body", record: @review %>
  </div>
</div>

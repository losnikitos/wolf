<% content_for :title, t("site.name") %>
<% content_for :description, t("site.meta_description") %>
<% content_for :image, seo_default_image_url %>

<div class="mx-auto w-full max-w-6xl px-5 pb-20 pt-16 sm:px-8 sm:pt-24">
  <section class="max-w-4xl">
    <button
      type="button"
      class="gaze mb-6 size-24 cursor-pointer border-0 bg-transparent p-0 sm:mb-8 sm:size-32"
      data-controller="gaze"
      data-action="click->gaze#smile"
      data-gaze-center-radius-value="48"
      data-gaze="center"
      aria-label="<%= t("site.name") %>"
    >
      <div class="relative size-full overflow-hidden rounded-full" data-gaze-target="frame">
        <% %w[center smile up up-right right down-right down down-left left up-left].each do |direction| %>
          <%= image_tag "wolf-#{direction}.jpg",
                alt: "",
                class: "gaze__face absolute inset-0 size-full object-cover",
                data: { gaze_face: direction },
                draggable: false %>
        <% end %>
      </div>
    </button>
    <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 sm:text-5xl lg:text-6xl dark:text-zinc-100">
      <%= t("site.name") %>
    </h1>
    <p class="mt-2 text-4xl font-normal tracking-tight text-zinc-400 sm:text-5xl lg:text-6xl dark:text-zinc-500">
      <%= t("home.tagline") %>
    </p>
    <p class="mt-2 text-base text-zinc-600 dark:text-zinc-400">
      <%= t("home.bio_html", link: link_to(t("home.bio_telegram_link"), "https://t.me/intrigator", class: "font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900 dark:text-zinc-100 dark:decoration-zinc-600 dark:hover:decoration-zinc-100", target: "_blank", rel: "noopener noreferrer")).html_safe %>
    </p>
  </section>

  <% if @favorite_projects.any? %>
    <section class="mt-20 sm:mt-28" aria-label="<%= t("home.selected_projects") %>">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100">
          <%= t("home.selected_projects") %>
        </h2>
        <%= link_to t("home.all_projects"),
              projects_path,
              class: "font-medium text-zinc-600 underline decoration-zinc-300 underline-offset-4 transition hover:text-zinc-900 hover:decoration-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-zinc-100 dark:hover:decoration-zinc-100" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <% @favorite_projects.each_with_index do |project, i| %>
          <%= link_to project_path(project), class: ["group block overflow-hidden rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900 focus-visible:ring-offset-2 dark:focus-visible:ring-zinc-100 dark:focus-visible:ring-offset-zinc-950 lg:col-span-2"] do %>
            <div class="relative aspect-[4/5] overflow-hidden bg-zinc-100 h-full sm:aspect-[3/4] lg:aspect-[16/10] dark:bg-zinc-800">
              <%= render "shared/cover",
                    record: project,
                    show_title: false,
                    aspect_class: "absolute inset-0 h-full w-full",
                    media_class: "h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" %>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-zinc-950/20 to-transparent" aria-hidden="true"></div>
              <div class="relative flex h-full flex-col justify-end p-6">
                <% if project.year.present? %>
                  <span class="text-xs font-medium text-zinc-300"><%= project.year %></span>
                <% end %>
                <span class="mt-1 text-sm font-medium text-white sm:text-base">
                  <%= project.name.presence || t("projects.untitled") %>
                </span>
                <% if project.client&.name.present? %>
                  <span class="mt-0.5 text-sm text-zinc-300"><%= project.client.name %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="mt-24 max-w-2xl sm:mt-32">
    <p class="text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
      <% if @favorite_projects.any? %>
        <%= t("home.more_work_html", link: link_to(t("home.more_work_link"), projects_path, class: "font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900 dark:text-zinc-100 dark:decoration-zinc-600 dark:hover:decoration-zinc-100")).html_safe %>
      <% else %>
        <%= t("home.empty_portfolio_html", link: link_to(t("home.empty_portfolio_link"), projects_path, class: "font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900 dark:text-zinc-100 dark:decoration-zinc-600 dark:hover:decoration-zinc-100")).html_safe %>
      <% end %>
    </p>
  </section>
</div>

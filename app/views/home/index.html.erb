<% content_for :title, "Евгений Волк" %>

<div class="mx-auto w-full max-w-6xl px-5 pb-20 pt-16 sm:px-8 sm:pt-24">
  <section class="max-w-4xl">
    <div class="mb-6 size-24 overflow-hidden rounded-full sm:mb-8 sm:size-32">
      <%= image_tag "profile.jpg", alt: "", class: "size-full object-cover" %>
    </div>
    <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 sm:text-5xl lg:text-6xl">
      Евгений Волк
    </h1>
    <p class="mt-2 text-4xl font-normal tracking-tight text-zinc-400 sm:text-5xl lg:text-6xl">
      Клиентский сервис, нейминг, продакшен
    </p>
    <p class="mt-2 text-base text-zinc-600">
      Помогаю запускать проекты и усиливать действующие в качестве креативного и продуктового директора. Более 190 работ для MTV, СТС, «За рулём», Московского марафона, медицинских центров, магазинов и арт-пространств. Берусь за задачи под ключ: формирую стратегию, нейминг, дизайн-макеты и яркие бизнес-концепции с конкурентным отличием. Формирую команду под задачу, привлекаю внимание прессы, предлагаю чёткие решения. Работаю быстро, самостоятельно и с фокусом на результат. Задать вопрос о своём проекте можно <%= link_to "через Telegram", "https://t.me/intrigator", class: "font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900", target: "_blank", rel: "noopener noreferrer" %>.
    </p>
  </section>

  <% if @favorite_projects.any? %>
    <section class="mt-20 sm:mt-28" aria-label="Featured work">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <% @favorite_projects.each_with_index do |project, i| %>
          <%= link_to project_path(project), class: ["group block overflow-hidden rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900 focus-visible:ring-offset-2", ("lg:col-span-2" if i.zero?)] do %>
            <div class="relative aspect-[4/5] overflow-hidden bg-zinc-100 sm:aspect-[3/4] <%= "lg:aspect-[16/10]" if i.zero? %>">
              <%= render "projects/cover",
                    project: project,
                    aspect_class: "absolute inset-0 h-full w-full",
                    media_class: "h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" %>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-zinc-950/20 to-transparent" aria-hidden="true"></div>
              <div class="relative flex h-full flex-col justify-end p-6">
                <% if project.year.present? %>
                  <span class="text-xs font-medium text-zinc-300"><%= project.year %></span>
                <% end %>
                <span class="mt-1 text-sm font-medium text-white sm:text-base">
                  <%= project.name.presence || "Untitled project" %>
                </span>
                <% if project.client&.name.present? %>
                  <span class="mt-0.5 text-sm text-zinc-300"><%= project.client.name %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="mt-24 max-w-2xl sm:mt-32">
    <p class="text-base leading-relaxed text-zinc-600 sm:text-lg">
      <% if @favorite_projects.any? %>
        Больше работ — в разделе
        <%= link_to "проекты", projects_path, class: "font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900" %>.
      <% else %>
        Портфолио и кейсы появятся здесь. Пока можно посмотреть
        <%= link_to "проекты", projects_path, class: "font-medium text-zinc-900 underline decoration-zinc-300 underline-offset-4 transition hover:decoration-zinc-900" %>.
      <% end %>
    </p>
  </section>
</div>

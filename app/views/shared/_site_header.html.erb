<header class="border-b border-zinc-200/80 bg-white">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <%= link_to root_path,
          class: "flex items-center gap-2.5 rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900 focus-visible:ring-offset-2",
          aria: { label: "Евгений Волк" } do %>
      <span class="flex size-8 shrink-0 overflow-hidden rounded-full">
        <%= image_tag "profile.jpg", alt: "", class: "size-full object-cover" %>
      </span>
      <span class="text-sm font-bold text-zinc-900">Евгений Волк</span>
    <% end %>
    
    <nav class="flex items-center gap-5 sm:gap-6">
      <%= link_to "Клиенты",
            clients_path,
            class: class_names(
              "text-sm font-medium transition",
              request.path.start_with?("/clients") ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900"
            ) %>
      <%= link_to "Проекты",
            projects_path,
            class: class_names(
              "text-sm font-medium transition",
              current_page?(projects_path) ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900"
            ) %>
      <%= link_to "Медиа",
            media_path,
            class: class_names(
              "text-sm font-medium transition",
              request.path.start_with?("/media") ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900"
            ) %>
      <%= link_to "Выступления",
            talks_path,
            class: class_names(
              "text-sm font-medium transition",
              request.path.start_with?("/talks") ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900"
            ) %>
      <%= link_to "Отзывы",
            reviews_path,
            class: class_names(
              "text-sm font-medium transition",
              request.path.start_with?("/reviews") ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900"
            ) %>
      <%= link_to search_path,
            class: class_names(
              "inline-flex size-9 items-center justify-center rounded-full transition",
              current_page?(search_path) ? "bg-zinc-100 text-zinc-900" : "text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900"
            ),
            aria: { label: "Search" } do %>
        <%= heroicon "magnifying-glass", variant: :outline, options: { class: "size-5", aria_hidden: "true" } %>
      <% end %>
    </nav>
  </div>
</header>

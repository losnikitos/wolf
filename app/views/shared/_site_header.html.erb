<% nav_link_class = "text-sm font-medium whitespace-nowrap transition text-zinc-500 hover:text-zinc-900 aria-selected:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 dark:aria-selected:text-zinc-100" %>
<% search_link_class = "inline-flex size-9 items-center justify-center rounded-full transition text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 aria-selected:bg-zinc-100 aria-selected:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 dark:aria-selected:bg-zinc-800 dark:aria-selected:text-zinc-100" %>

<header class="border-b border-zinc-200/80 bg-white overflow-y-auto no-scrollbar dark:border-zinc-800/80 dark:bg-zinc-950">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <%= link_to root_path,
          class: "flex items-center gap-2.5 rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-900 focus-visible:ring-offset-2 dark:focus-visible:ring-zinc-100 dark:focus-visible:ring-offset-zinc-950",
          aria: { label: t("site.name") } do %>
      <span class="flex size-8 shrink-0 overflow-hidden rounded-full">
        <%= image_tag "profile.jpg", alt: "", class: "size-full object-cover" %>
      </span>
      <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100"><%= t("site.name") %></span>
    <% end %>

    <div class="flex items-center gap-4 sm:gap-5">
      <nav class="flex items-center gap-5 sm:gap-6">
      <%= link_to t("nav.clients"),
            clients_path,
            class: nav_link_class,
            aria: { selected: request.path.start_with?("/clients") } %>
      <%= link_to t("nav.projects"),
            projects_path,
            class: nav_link_class,
            aria: { selected: current_page?(projects_path) } %>
      <%= link_to t("nav.media"),
            media_path,
            class: nav_link_class,
            aria: { selected: request.path.start_with?("/media") } %>
      <%= link_to t("nav.talks"),
            talks_path,
            class: nav_link_class,
            aria: { selected: request.path.start_with?("/talks") } %>
      <%= link_to t("nav.reviews"),
            reviews_path,
            class: nav_link_class,
            aria: { selected: request.path.start_with?("/reviews") } %>
      <%= link_to t("nav.blog"),
            blog_index_path,
            class: nav_link_class,
            aria: { selected: request.path.start_with?("/blog") } %>
      <%= link_to search_path,
            class: search_link_class,
            aria: { label: t("nav.search"), selected: current_page?(search_path) } do %>
        <%= heroicon "magnifying-glass", variant: :outline, options: { class: "size-5", aria_hidden: "true" } %>
      <% end %>
      </nav>
      <%= render "shared/theme_switcher" %>
      <%= render "shared/locale_switcher" %>
    </div>
  </div>
</header>

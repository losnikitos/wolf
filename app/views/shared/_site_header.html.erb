<header class="border-b border-zinc-200/80 bg-white">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <%= link_to root_path, class: "flex size-8 shrink-0 items-center justify-center rounded-full border border-zinc-200 text-zinc-900 transition hover:border-zinc-300", aria: { label: "Home" } do %>
      <span class="text-xs font-semibold tracking-tight" aria-hidden="true">EV</span>
    <% end %>

    <nav class="flex items-center gap-5 sm:gap-6">
      <%= link_to "Clients",
            clients_path,
            class: class_names(
              "text-sm font-medium transition",
              request.path.start_with?("/clients") ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900"
            ) %>
      <%= link_to "Projects",
            projects_path,
            class: class_names(
              "text-sm font-medium transition",
              current_page?(projects_path) ? "text-zinc-900" : "text-zinc-500 hover:text-zinc-900"
            ) %>
      <%= link_to projects_path(anchor: "search"),
            class: "inline-flex size-9 items-center justify-center rounded-full text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900",
            aria: { label: "Search projects" } do %>
        <%= heroicon "magnifying-glass", variant: :outline, options: { class: "size-5", aria_hidden: "true" } %>
      <% end %>
    </nav>
  </div>
</header>

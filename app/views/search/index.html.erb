<% content_for :title, "Search" %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <header class="flex flex-col gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-900">Search</h1>
      <p class="mt-1 text-sm text-zinc-500">Projects, media, clients, and talks by name</p>
    </div>

    <%= form_with url: search_path, method: :get,
          data: { controller: "search", turbo_frame: "search_results", turbo_action: "advance" },
          class: "relative max-w-md" do |form| %>
      <%= form.search_field :q,
            value: @query,
            placeholder: "Search by name…",
            autocomplete: "off",
            autofocus: true,
            data: { action: "input->search#submit" },
            class: "w-full rounded-xl border border-zinc-200 bg-white py-2.5 pl-10 pr-4 text-sm text-zinc-900 shadow-sm shadow-zinc-950/5 placeholder:text-zinc-400 focus:border-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900/10" %>
      <%= heroicon "magnifying-glass",
            variant: :mini,
            options: {
              class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-zinc-400",
              aria_hidden: "true"
            } %>
    <% end %>
  </header>

  <%= turbo_frame_tag "search_results", class: "flex flex-col gap-10" do %>
    <%= render "results" %>
  <% end %>
</div>

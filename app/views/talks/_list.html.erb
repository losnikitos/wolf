<% if talks.any? %>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% talks.each do |talk| %>
      <% talk_title = talk.name.presence || t("talks.untitled") %>
      <li>
        <%= link_to talk_path(talk),
              class: "group block h-full rounded-2xl border border-zinc-200/80 bg-white shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 hover:shadow-md hover:shadow-zinc-950/10" do %>
          <article class="flex h-full flex-col overflow-hidden rounded-2xl">
            <%= render "shared/cover",
                  record: talk,
                  title: talk_title,
                  media_class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]" %>
            <div class="flex flex-1 flex-col gap-3 p-5">
              <div class="flex flex-wrap items-center gap-2">
                <% if talk.talk_date.present? %>
                  <span class="inline-flex rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">
                    <%= l(talk.talk_date, format: :long) %>
                  </span>
                <% end %>
              </div>
              <% if talk.cover_for_display? %>
                <h2 class="text-lg font-semibold leading-snug text-zinc-900 group-hover:text-zinc-700">
                  <%= talk_title %>
                </h2>
              <% end %>
              <% if talk.organizer.present? %>
                <p class="text-sm text-zinc-500"><%= talk.organizer %></p>
              <% end %>
              <% if talk.location.present? %>
                <p class="mt-auto text-xs text-zinc-400"><%= talk.location %></p>
              <% end %>
            </div>
          </article>
        <% end %>
      </li>
    <% end %>
  </ul>
<% elsif local_assigns[:empty_message].present? %>
  <div class="rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/80 px-6 py-16 text-center">
    <p class="text-zinc-600"><%= empty_message %></p>
  </div>
<% end %>

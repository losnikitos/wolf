<% content_for :title, t("talks.title") %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-10 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header", title: t("talks.title") %>

  <% if @talks_by_year.any? %>
    <% @year_names.each do |year_name| %>
      <% talks = @talks_by_year[year_name] %>
      <section class="flex flex-col gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400"><%= localized_year_label(year_name) %></h2>
        <%= render "list", talks: talks %>
      </section>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/80 px-6 py-16 text-center">
      <p class="text-zinc-600"><%= t("talks.no_talks") %></p>
      <p class="mt-2 text-sm text-zinc-500"><%= t("shared.run_notion_sync") %></p>
    </div>
  <% end %>
</div>

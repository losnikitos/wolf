<% content_for :title, @talk.name.presence || "Talk" %>
<% talk_title = @talk.name.presence || "Untitled talk" %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: talk_title,
        breadcrumbs: [
          { label: "Talks", path: talks_path },
          { label: talk_title, current: true }
        ] %>

  <div class="flex flex-col gap-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <% if @talk.talk_date.present? %>
          <span class="inline-flex rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600">
            <%= l(@talk.talk_date, format: :long) %>
          </span>
        <% end %>
        <% if @talk.archived? %>
          <span class="inline-flex rounded-md bg-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-700">Archived</span>
        <% end %>
      </div>
      <%= render "shared/notion_actions", record: @talk %>
    </div>

    <% meta_bits = [@talk.organizer, @talk.location].compact %>
    <% if meta_bits.any? %>
      <p class="text-base text-zinc-600"><%= meta_bits.join(" · ") %></p>
    <% end %>

    <% if @talk.topic.present? %>
      <p class="text-base leading-relaxed text-zinc-700"><%= @talk.topic %></p>
    <% end %>

    <%= render "shared/notion_body", record: @talk %>

    <% if @talk.project.present? %>
      <div class="border-t border-zinc-100 pt-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-400">Related project</h2>
        <p class="mt-2">
          <%= link_to @talk.project.name,
                project_path(@talk.project),
                class: "text-sm font-medium text-zinc-700 transition hover:text-zinc-900" %>
        </p>
      </div>
    <% end %>

    <% if @talk.notion_created_at.present? || @talk.notion_last_edited_at.present? || @talk.last_synced_at.present? %>
      <footer class="border-t border-zinc-100 pt-6 text-xs text-zinc-400">
        <ul class="flex flex-col gap-1 sm:flex-row sm:flex-wrap sm:gap-x-6 sm:gap-y-1">
          <% if @talk.notion_created_at.present? %>
            <li>Created in Notion <%= l(@talk.notion_created_at, format: :long) %></li>
          <% end %>
          <% if @talk.notion_last_edited_at.present? %>
            <li>Last edited <%= l(@talk.notion_last_edited_at, format: :long) %></li>
          <% end %>
          <% if @talk.last_synced_at.present? %>
            <li>Synced <%= time_ago_in_words(@talk.last_synced_at) %> ago</li>
          <% end %>
        </ul>
      </footer>
    <% end %>
  </div>
</div>

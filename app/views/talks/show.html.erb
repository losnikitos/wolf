<% content_for :title, @talk.name.presence || t("talks.page_title") %>
<% talk_title = @talk.name.presence || t("talks.untitled") %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: talk_title,
        breadcrumbs: [
          { label: t("talks.title"), path: talks_path },
          { label: talk_title, current: true }
        ] %>

  <div class="flex flex-col gap-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <% if @talk.talk_date.present? %>
          <span class="inline-flex rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600">
            <%= l(@talk.talk_date, format: :long) %>
          </span>
        <% end %>
        <% if @talk.archived? %>
          <span class="inline-flex rounded-md bg-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-700"><%= t("shared.archived") %></span>
        <% end %>
      </div>
      <%= render "shared/notion_actions", record: @talk %>
    </div>

    <% meta_bits = [@talk.organizer, @talk.location].compact %>
    <% if meta_bits.any? %>
      <p class="text-base text-zinc-600"><%= meta_bits.join(" · ") %></p>
    <% end %>

    <% if @talk.topic.present? %>
      <p class="text-base leading-relaxed text-zinc-700"><%= @talk.topic %></p>
    <% end %>

    <%= render "shared/notion_body", record: @talk %>

    <% if @talk.project.present? %>
      <div class="border-t border-zinc-100 pt-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-400"><%= t("shared.related_project") %></h2>
        <p class="mt-2">
          <%= link_to @talk.project.name,
                project_path(@talk.project),
                class: "text-sm font-medium text-zinc-700 transition hover:text-zinc-900" %>
        </p>
      </div>
    <% end %>

    <%= render "shared/recommended",
          items: @recommended_talks,
          heading: t("shared.recommended_heading"),
          card_partial: "talks/card" %>
  </div>
</div>

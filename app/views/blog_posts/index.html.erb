<% content_for :title, t("blog.title") %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-10 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header", title: t("blog.title") %>

  <% if @posts_by_year.any? %>
    <% @year_names.each do |year_name| %>
      <% posts = @posts_by_year[year_name] %>
      <section class="flex flex-col gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400 dark:text-zinc-500"><%= localized_year_label(year_name) %></h2>
        <%= render "list", posts: posts %>
      </section>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/80 px-6 py-16 text-center dark:border-zinc-800 dark:bg-zinc-900/50">
      <p class="text-zinc-600 dark:text-zinc-400"><%= t("blog.no_posts") %></p>
    </div>
  <% end %>
</div>

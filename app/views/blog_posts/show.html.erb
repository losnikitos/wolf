<% post_title = @post.title.presence || t("blog.untitled") %>

<% content_for :title, post_title %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: post_title,
        breadcrumbs: [
          { label: t("blog.title"), path: blog_index_path },
          { label: post_title, current: true }
        ] %>

  <div class="flex flex-col gap-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <% if @post.published_at.present? %>
          <span class="inline-flex rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
            <%= l(@post.published_at, format: :long) %>
          </span>
        <% end %>
        <% if @post.archived? %>
          <span class="inline-flex rounded-md bg-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-700 dark:text-zinc-200"><%= t("shared.archived") %></span>
        <% end %>
      </div>

      <%= link_to t("blog.view_on_telegram"),
            @post.telegram_url,
            class: "text-sm font-medium text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
            rel: "noopener noreferrer",
            target: "_blank" %>
    </div>

    <% if @post.body.present? || @post.poll.present? %>
      <section class="max-w-none space-y-1 text-[15px] leading-relaxed">
        <%= render_telegram_body(@post) %>
      </section>
    <% end %>

    <% if @post.ordered_media.any? %>
      <section class="grid gap-4 sm:grid-cols-2">
        <% @post.ordered_media.each do |attachment| %>
          <div class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800/80 dark:bg-zinc-900">
            <% if attachment.image? %>
              <%= image_tag url_for(attachment), alt: "", class: "h-full w-full object-cover" %>
            <% elsif attachment.video? %>
              <%= video_tag url_for(attachment), controls: true, playsinline: true, class: "h-full w-full" %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>

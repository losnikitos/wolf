<% content_for :title, t("media.title") %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-10 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header", title: t("media.title") %>

  <% if @appearances_by_publication.any? %>
    <% @publication_names.each do |publication_name| %>
      <% appearances = @appearances_by_publication[publication_name] %>
      <section class="flex flex-col gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400 dark:text-zinc-500">
          <%= publication_name == "Unknown" ? t("shared.unknown") : publication_name %>
        </h2>
        <%= render "list", media_appearances: appearances %>
      </section>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/80 px-6 py-16 text-center dark:border-zinc-800 dark:bg-zinc-900/50">
      <p class="text-zinc-600 dark:text-zinc-400"><%= t("media.no_appearances") %></p>
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400"><%= t("shared.run_notion_sync") %></p>
    </div>
  <% end %>
</div>

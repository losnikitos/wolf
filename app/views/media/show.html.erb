<% content_for :title, @media_appearance.name.presence || t("media.page_title") %>
<% content_for :description, record_seo_description(@media_appearance) %>
<% content_for :image, seo_cover_image_url(@media_appearance) %>
<% appearance_title = @media_appearance.name.presence || t("media.untitled") %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: appearance_title,
        breadcrumbs: [
          { label: t("media.title"), path: media_path },
          { label: appearance_title, current: true }
        ] %>

  <div class="flex flex-col gap-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <% if @media_appearance.appearance_date.present? %>
          <span class="inline-flex rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
            <%= l(@media_appearance.appearance_date, format: :long) %>
          </span>
        <% end %>
        <% if @media_appearance.archived? %>
          <span class="inline-flex rounded-md bg-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-700 dark:text-zinc-200"><%= t("shared.archived") %></span>
        <% end %>
      </div>
      <%= render "shared/notion_actions", record: @media_appearance %>
    </div>

    <% if @media_appearance.url.present? %>
      <% link_label = @media_appearance.publication.present? ? t("media.read_on_publication", publication: @media_appearance.publication) : @media_appearance.url %>
      <p>
        <%= link_to link_label,
              @media_appearance.url,
              class: "text-sm font-medium text-zinc-600 underline decoration-zinc-300 underline-offset-2 transition hover:text-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-zinc-100",
              target: "_blank",
              rel: "noopener noreferrer" %>
      </p>
    <% elsif @media_appearance.publication.present? %>
      <p class="text-base font-medium text-zinc-700 dark:text-zinc-300"><%= @media_appearance.publication %></p>
    <% end %>

    <%= render "shared/notion_body", record: @media_appearance %>

    <% if @media_appearance.project.present? %>
      <div class="border-t border-zinc-100 pt-8 dark:border-zinc-800">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-400 dark:text-zinc-500"><%= t("shared.related_project") %></h2>
        <p class="mt-2">
          <%= link_to @media_appearance.project.name,
                project_path(@media_appearance.project),
                class: "text-sm font-medium text-zinc-700 transition hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-zinc-100" %>
        </p>
      </div>
    <% end %>

    <%= render "shared/recommended",
          items: @recommended_media_appearances,
          heading: t("shared.recommended_heading"),
          card_partial: "media/card" %>
  </div>
</div>

<% appearance_title = item.name.presence || t("media.untitled") %>
<%= link_to media_appearance_path_for(item),
      class: "group block h-full rounded-2xl border border-zinc-200/80 bg-white shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 hover:shadow-md hover:shadow-zinc-950/10" do %>
  <article class="flex h-full flex-col overflow-hidden rounded-2xl">
    <%= render "shared/cover",
          record: item,
          title: appearance_title,
          media_class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]" %>
    <div class="flex flex-1 flex-col gap-3 p-5">
      <div class="flex flex-wrap items-center gap-2">
        <% if item.appearance_date.present? %>
          <span class="inline-flex rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">
            <%= l(item.appearance_date, format: :long) %>
          </span>
        <% end %>
      </div>
      <h3 class="text-lg font-semibold leading-snug text-zinc-900 group-hover:text-zinc-700">
        <%= appearance_title %>
      </h3>
      <% if item.publication.present? %>
        <p class="mt-auto text-sm text-zinc-500"><%= item.publication %></p>
      <% end %>
    </div>
  </article>
<% end %>

<% if media_appearances.any? %>
  <ul class="grid gap-4 sm:grid-cols-2">
    <% media_appearances.each do |appearance| %>
      <li>
        <%= link_to media_appearance_path_for(appearance),
              class: "group flex h-full flex-col rounded-xl border border-zinc-200/80 bg-white px-5 py-4 shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 hover:shadow-md hover:shadow-zinc-950/10" do %>
          <div class="flex flex-wrap items-center gap-2">
            <% if appearance.appearance_date.present? %>
              <span class="inline-flex rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">
                <%= l(appearance.appearance_date, format: :long) %>
              </span>
            <% end %>
          </div>
          <h2 class="mt-3 text-lg font-semibold leading-snug text-zinc-900 group-hover:text-zinc-700">
            <%= appearance.name.presence || t("media.untitled") %>
          </h2>
          <% if appearance.publication.present? %>
            <p class="mt-2 text-sm text-zinc-500"><%= appearance.publication %></p>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% elsif local_assigns[:empty_message].present? %>
  <div class="rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/80 px-6 py-16 text-center">
    <p class="text-zinc-600"><%= empty_message %></p>
  </div>
<% end %>

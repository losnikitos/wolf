<% project_title = item.name.presence || t("projects.untitled") %>
<%= link_to project_path_for(item, client: local_assigns[:client]), data: { turbo_frame: "_top" }, class: "group block h-full rounded-2xl border border-zinc-200/80 bg-white shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 hover:shadow-md hover:shadow-zinc-950/10" do %>
  <article class="flex h-full flex-col overflow-hidden rounded-2xl">
    <div class="relative overflow-hidden">
      <%= render "shared/cover",
            record: item,
            title: project_title,
            media_class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]" %>
      <% if item.favorite? %>
        <%= heroicon "star",
              variant: :solid,
              options: {
                class: "absolute right-3 top-3 size-7 text-yellow-400 drop-shadow-sm",
                aria_hidden: "true",
                title: t("shared.favorite")
              } %>
      <% end %>
    </div>
    <div class="flex flex-1 flex-col gap-3 p-5">
      <div class="flex flex-wrap items-center gap-2">
        <% if item.year.present? %>
          <span class="inline-flex rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600"><%= item.year %></span>
        <% end %>
        <% if item.status.present? %>
          <span class="inline-flex rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-800"><%= item.status %></span>
        <% end %>
      </div>
      <% if item.cover_for_display? %>
        <h3 class="text-lg font-semibold leading-snug text-zinc-900 group-hover:text-zinc-700">
          <%= project_title %>
        </h3>
      <% end %>
      <% if item.client&.name.present? %>
        <p class="text-sm text-zinc-500"><%= item.client.name %></p>
      <% end %>
      <% if item.city.present? || item.project_type.present? %>
        <p class="mt-auto text-xs text-zinc-400">
          <%= [item.city, item.project_type].compact.join(" · ") %>
        </p>
      <% end %>
    </div>
  </article>
<% end %>

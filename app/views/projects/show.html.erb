<% content_for :title, @project.name.presence || t("projects.page_title") %>
<% project_title = @project.name.presence || t("projects.untitled") %>
<% project_breadcrumbs = if @client
  [
    { label: t("clients.title"), path: clients_path },
    { label: @client.name, path: client_path(@client) },
    { label: project_title, current: true }
  ]
else
  [
    { label: t("projects.title"), path: projects_path },
    { label: project_title, current: true }
  ]
end %>
<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: project_title,
        breadcrumbs: project_breadcrumbs %>

  <% if @project.notion_cover_for_display? %>
    <div class="overflow-hidden rounded-2xl">
      <%= render "shared/cover",
            record: @project,
            cover_method: :notion_cover_for_display,
            aspect_class: "aspect-[21/9]",
            media_class: "h-full w-full object-cover",
            size: :full %>
    </div>
  <% end %>

  <div class="flex flex-col gap-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <% if @project.year.present? %>
          <span class="inline-flex rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"><%= @project.year %></span>
        <% end %>
        <% if @project.status.present? %>
          <span class="inline-flex rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-800"><%= @project.status %></span>
        <% end %>
        <% if @project.archived? %>
          <span class="inline-flex rounded-md bg-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-700 dark:text-zinc-200"><%= t("shared.archived") %></span>
        <% end %>
        <% if @project.favorite? %>
          <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-900">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <%= t("shared.favorite") %>
          </span>
        <% end %>
        <% [
          ["roles", Array(@project.roles)],
          ["deliverables", Array(@project.deliverables)],
          ["directions", Array(@project.directions)]
        ].each do |kind, items| %>
          <% items.compact_blank.each do |item| %>
            <%= link_to item, project_tag_path(kind, item), class: project_tag_link_class %>
          <% end %>
        <% end %>
      </div>
      <%= render "shared/notion_actions", record: @project %>
    </div>

    <% meta_bits = [@project.client&.name, @project.city, @project.project_type].compact %>
    <% if meta_bits.any? %>
      <p class="text-base text-zinc-600 dark:text-zinc-400"><%= meta_bits.join(" · ") %></p>
    <% end %>

    <%= render "projects/body" %>

    <%= render "shared/recommended",
          items: @recommended_projects,
          heading: t("shared.recommended_heading"),
          card_partial: "projects/card",
          card_locals: @client ? { client: @client } : {} %>
  </div>
</div>

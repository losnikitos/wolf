<% content_for :title, project_collection_title(@kind, @tag) %>
<% content_for :description, t("projects.meta_description") %>
<% content_for :image, seo_default_image_url %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: project_collection_title(@kind, @tag),
        breadcrumbs: [
          { label: t("projects.title"), path: projects_path },
          { label: project_tag_kind_label(@kind) },
          { label: @tag, current: true }
        ] %>

  <%= render "list",
        projects: @projects,
        empty_message: t("projects.no_tagged_projects", tag: h(@tag)) %>
</div>

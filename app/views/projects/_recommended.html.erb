<% if recommended_projects.any? %>
  <div class="border-t border-zinc-100 pt-8">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-400"><%= t("projects.recommended_heading") %></h2>
    <ul class="mt-5 grid gap-5 sm:grid-cols-2">
      <% recommended_projects.each do |project| %>
        <% project_title = project.name.presence || t("projects.untitled") %>
        <li>
          <%= link_to project_path_for(project, client: local_assigns[:client]), data: { turbo_frame: "_top" }, class: "group block h-full rounded-2xl border border-zinc-200/80 bg-white shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 hover:shadow-md hover:shadow-zinc-950/10" do %>
            <article class="flex h-full flex-col overflow-hidden rounded-2xl">
              <div class="relative overflow-hidden">
                <%= render "shared/cover",
                      record: project,
                      title: project_title,
                      media_class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]" %>
                <% if project.favorite? %>
                  <span class="absolute right-3 top-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber-400/95 text-amber-950 shadow-sm backdrop-blur-sm" title="<%= t("shared.favorite") %>">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  </span>
                <% end %>
              </div>
              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <% if project.year.present? %>
                    <span class="inline-flex rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600"><%= project.year %></span>
                  <% end %>
                  <% if project.status.present? %>
                    <span class="inline-flex rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-800"><%= project.status %></span>
                  <% end %>
                </div>
                <h3 class="text-lg font-semibold leading-snug text-zinc-900 group-hover:text-zinc-700">
                  <%= project_title %>
                </h3>
                <% if project.client&.name.present? %>
                  <p class="text-sm text-zinc-500"><%= project.client.name %></p>
                <% end %>
                <% if project.city.present? || project.project_type.present? %>
                  <p class="mt-auto text-xs text-zinc-400">
                    <%= [project.city, project.project_type].compact.join(" · ") %>
                  </p>
                <% end %>
              </div>
            </article>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

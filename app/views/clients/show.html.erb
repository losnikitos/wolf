<% content_for :title, @client.name %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-8 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header",
        title: @client.name,
        breadcrumbs: [
          { label: t("clients.title"), path: clients_path },
          { label: @client.name, current: true }
        ] %>

  <% if @client.client_group.present? %>
    <span class="inline-flex w-fit rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"><%= @client.client_group %></span>
  <% end %>

  <%= render "projects/list",
        projects: @projects,
        client: @client,
        empty_message: t("clients.no_projects") %>
</div>

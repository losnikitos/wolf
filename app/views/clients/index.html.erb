<% content_for :title, t("clients.title") %>

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-10 px-5 pb-16 pt-10 sm:px-8">
  <%= render "shared/page_header", title: t("clients.title") %>

  <% if @clients_by_group.any? %>
    <% @group_names.each do |group_name| %>
      <% clients = @clients_by_group[group_name] %>
      <section class="flex flex-col gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400"><%= group_name %></h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <% clients.each do |client| %>
            <li>
              <%= link_to client_path(client),
                    class: "group flex items-center justify-between rounded-xl border border-zinc-200/80 bg-white px-5 py-4 shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 hover:shadow-md hover:shadow-zinc-950/10" do %>
                <span class="font-medium text-zinc-900 group-hover:text-zinc-700"><%= client.name %></span>
                <% project_count = @project_counts[client.id].to_i %>
                <% if project_count.positive? %>
                  <span class="text-xs tabular-nums text-zinc-400"><%= t("projects.count", count: project_count) %></span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/80 px-6 py-16 text-center">
      <p class="text-zinc-600"><%= t("clients.no_clients") %></p>
      <p class="mt-2 text-sm text-zinc-500"><%= t("shared.run_notion_sync") %></p>
    </div>
  <% end %>
</div>
